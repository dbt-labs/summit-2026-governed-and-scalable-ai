# TEMPLATE — inert by default. See .github/workflows/README.md before activating.
#
# Skeleton for validating that CODEOWNERS is well-formed and that every owner
# resolves to a real team or user. Resolving org teams needs more access than the
# default GITHUB_TOKEN carries, which is why this pattern uses a GitHub App
# credential.
#
# Every `example-*` value below is a placeholder. Copy this file, drop the
# `.example` suffix, and supply your own action references, reviewed commit SHAs,
# secret names, and validator inputs.
#
# This workflow consumes secrets, so on activation it MUST stay gated. The
# `environment:` below is that gate — create an environment of the same name with
# required reviewers so a human approves each run before secrets are issued. Do
# not swap it for an ungated automatic trigger.
#
# Note: any real validator you wire up will fail against this repository's
# placeholder @example-org/* owners by design. Point CODEOWNERS at real teams first.
name: CODEOWNERS Coverage Check
permissions:
  contents: read

on:
  pull_request:
  workflow_dispatch:

jobs:
  validate-codeowners:
    # Optional trusted-actor guard. Replace with the actor(s) you want to skip,
    # or delete the line if you have nothing to exclude.
    if: github.actor != 'example-bot[bot]'
    runs-on: ubuntu-24.04
    # Approval gate for secret access — see the note above.
    environment: example-approval-gate
    steps:
      # Pin every action to a full commit SHA you have reviewed. Version tags are
      # mutable; a SHA is not.
      - uses: "actions/checkout@example-commit-sha"
      - uses: "example-org/example-codeowners-validator@example-commit-sha"
        env:
          INPUT_GITHUB_APP_PRIVATE_KEY: "${{ secrets.EXAMPLE_APP_PRIVATE_KEY }}"
          INPUT_GITHUB_APP_INSTALLATION_ID: "${{ secrets.EXAMPLE_APP_INSTALLATION_ID }}"
          INPUT_GITHUB_APP_ID: "${{ secrets.EXAMPLE_APP_ID }}"
        with:
          checks: "example-check,example-other-check"
          experimental_checks: "example-experimental-check"
